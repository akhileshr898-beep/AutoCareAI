# AutoCareAI Environment Variables
# Copy this file to .env and fill in your values

# Flask secret key (generate a random one for production)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Database URL
# Local MySQL: mysql+pymysql://root:password@localhost:3306/autocare_ai
# Render PostgreSQL: Set automatically via DATABASE_URL
# SQLite fallback: sqlite:///autocare.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/autocare_ai

# Flask environment (development or production)
FLASK_ENV=development
